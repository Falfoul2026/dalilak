# Copy to .env and fill in. Never commit .env.

# Supabase → Project Settings → API (safe for the browser; RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site address (used for canonical URLs, sitemap, QR codes)
VITE_SITE_URL=https://dalilak.example

# Feature flags
# Visitor accounts (Saved, reviews, report/claim forms). Off: shops are added by the admin.
VITE_USER_ACCOUNTS=false
VITE_SMS_LOGIN_ENABLED=false
VITE_GOOGLE_LOGIN_ENABLED=false

# Only for `npm run import` on your computer (Supabase → Connect → Session pooler).
# SECRET: contains the database password.
DATABASE_URL=

# Public contact on the "Add your shop" page (not secret; set in netlify.toml)
VITE_CONTACT_WHATSAPP=
VITE_CONTACT_EMAIL=
